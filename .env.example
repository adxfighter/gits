# Copy to .env and fill in local values. Never commit .env.

# PostgreSQL
POSTGRES_DB=gits
POSTGRES_USER=gits
POSTGRES_PASSWORD=change-me-local

# Demo accounts created on api startup (local demo only)
DEMO_EMPLOYER_EMAIL=employer@demo.local
DEMO_EMPLOYER_PASSWORD=change-me
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_ADMIN_PASSWORD=change-me

# Web UI port on the host
WEB_PORT=8080

# Sandbox: runc (default, works on Docker Desktop for Windows) or runsc (gVisor, Linux hosts only)
SANDBOX_RUNTIME=runc
SANDBOX_IMAGE=gits-sandbox-java:local
RUNNER_CONCURRENCY=2

# Task bank location inside the api container (mounted read-only from ./tasks)
TASKBANK_PATH=/opt/gits/tasks
