{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gits.local/schema/template.schema.json",
  "title": "GITS task template",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "title", "competencies", "base_level", "description", "difficulty_model", "domains"],
  "properties": {
    "code": { "type": "string", "pattern": "^T[0-9]{2}$|^CAL$" },
    "title": { "type": "string", "minLength": 5, "maxLength": 300 },
    "competencies": {
      "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^java(\\.[a-z][a-z0-9_]*)+$" }
    },
    "base_level": { "enum": ["junior", "middle", "senior"] },
    "description": { "type": "string", "minLength": 20 },
    "difficulty_model": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["values", "meaning"],
        "properties": {
          "values": { "type": "array", "minItems": 1 },
          "meaning": { "type": "string" }
        }
      }
    },
    "domains": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 2 }
    }
  }
}
