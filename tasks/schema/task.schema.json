{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gits.local/schema/task.schema.json",
  "title": "GITS task variant",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "template", "level", "domain", "time_limit_min", "difficulty_params", "editable",
               "readonly", "flaky_policy", "rubric"],
  "properties": {
    "code": { "type": "string", "pattern": "^(T[0-9]{2}|CAL)-v[0-9]{2}$" },
    "template": { "type": "string", "pattern": "^T[0-9]{2}$|^CAL$" },
    "kind": { "enum": ["task", "calibration"], "default": "task" },
    "level": { "enum": ["junior", "middle", "senior"] },
    "domain": { "type": "string", "minLength": 2, "maxLength": 100 },
    "time_limit_min": { "type": "integer", "minimum": 1, "maximum": 120 },
    "difficulty_params": { "type": "object" },
    "editable": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/mainPath" }
    },
    "readonly": {
      "type": "array", "uniqueItems": true,
      "items": { "$ref": "#/$defs/mainPath" }
    },
    "flaky_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runs", "reference_pass_min", "starter_fail_min"],
      "properties": {
        "runs": { "type": "integer", "minimum": 1, "maximum": 50 },
        "reference_pass_min": { "type": "integer", "minimum": 1 },
        "starter_fail_min": { "type": "integer", "minimum": 0 }
      }
    },
    "rubric": {
      "type": "array", "minItems": 3, "maxItems": 6,
      "items": { "type": "string", "minLength": 5 }
    }
  },
  "$defs": {
    "mainPath": {
      "type": "string",
      "pattern": "^src/main/java/([A-Za-z_$][A-Za-z0-9_$]*/)*[A-Za-z_$][A-Za-z0-9_$]*\\.java$"
    }
  }
}
